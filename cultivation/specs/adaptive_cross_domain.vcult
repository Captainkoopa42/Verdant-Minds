name: adaptive_cross_domain
description: Cross-domain with adaptive phase transitions

phases:
  - name: domain_a
    min_cycles: 20
    max_cycles: 60
    advance_when:
      all:
        - basin_count >= 2
        - emergent_count >= 20
    topics:
      - "explore ethical frameworks for autonomous systems"
      - "examine how moral reasoning handles genuine dilemmas"
    self_reflect_interval: 15
    on_end:
      - snapshot_basins
      - checkpoint

  - name: domain_b
    min_cycles: 20
    max_cycles: 60
    advance_when:
      all:
        - basin_count >= 3
        - emergent_count >= 40
    topics:
      - "investigate causal reasoning under uncertainty"
      - "examine how complex systems produce emergent causation"
    self_reflect_interval: 15
    on_end:
      - snapshot_basins
      - checkpoint

  - name: bridge
    min_cycles: 20
    max_cycles: 100
    advance_when:
      any:
        - emergent_rate < 0.3 for 15 cycles
        - emergent_count >= 100
    topics:
      - "explore how ethical constraints interact with causal understanding"
      - "examine emergence at the boundary of ethics and causality"
    self_reflect_when:
      any:
        - interval 10
        - latest_bud_within 3 cycles
    self_reflect_cooldown: 5
    basin_topics:
      understimulated:
        threshold: 0.5
        topics:
          - "revisit foundational connections in {basin_domain}"

convergence:
  all:
    - emergent_rate < 0.2 for 20 cycles
  max_total_cycles: 300
  min_total_cycles: 80

validation:
  expect_earlier_share: 1.0
  expect_min_basins: 2
