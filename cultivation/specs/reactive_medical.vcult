name: reactive_medical_ethics
description: Medical ethics with milestone-based phases

seeds:
  additional:
    - informed_consent
    - triage
    - patient_autonomy
    - clinical_judgment

settings:
  basin_routing: true
  enable_all_dynamics: true
  boundary_use_ecwf: true
  density_regulation: true

phases:
  - name: foundation
    min_cycles: 30
    max_cycles: 80
    advance_when:
      all:
        - emergent_count >= 30
        - basin_count >= 2
    topics:
      - "explore the relationship between medical knowledge and ethical responsibility"
      - "examine how patient autonomy intersects with clinical judgment"
      - "consider the tension between beneficence and informed consent"
    self_reflect_interval: 20
    on_start:
      - force_self_reflect
    on_end:
      - checkpoint

  - name: dilemmas
    min_cycles: 50
    max_cycles: 200
    advance_when:
      all:
        - emergent_count >= 100
        - basin_count >= 3
    topics:
      - "analyze triage dilemmas where multiple patients need scarce resources"
      - "examine end of life decisions when patient wishes conflict with family"
      - "consider pediatric consent when children and parents disagree"
    self_reflect_when:
      any:
        - interval 15
        - latest_bud_within 3 cycles
        - t_g > 0.75
    self_reflect_cooldown: 5
    basin_topics:
      understimulated:
        threshold: 0.5
        topics:
          - "reconsider overlooked aspects of {basin_domain}"
    on_end:
      - checkpoint

  - name: integration
    min_cycles: 30
    max_cycles: 150
    advance_when:
      any:
        - emergent_rate < 0.3 for 20 cycles
        - emergent_count >= 200
    topics:
      - "synthesize across all ethical frameworks encountered"
      - "examine how earlier ethical insights connect to recent dilemmas"
      - "reflect on what remains unresolved"
    self_reflect_when:
      any:
        - interval 10
        - emergent_rate < 0.5 for 5 cycles
    self_reflect_cooldown: 3
    on_start:
      - force_self_reflect
    on_end:
      - checkpoint

convergence:
  all:
    - earlier_share == 1.0
    - emergent_rate < 0.2 for 30 cycles
  max_total_cycles: 500
  min_total_cycles: 150

validation:
  expect_earlier_share: 1.0
  expect_min_emergents: 100
  expect_min_basins: 3
  expect_min_semantic_score: 0.7
