{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verdant.workbench.event.v1",
  "title": "Verdant Workbench Event Envelope v1",
  "type": "object",
  "required": ["schema","event_id","run_id","organism_id","engine_cycle","state_revision","event_type","source_command_id","timestamp_utc","payload","payload_sha256"],
  "properties": {
    "schema": {"const":"verdant.workbench.event.v1"},
    "event_id": {"type":"string"},
    "run_id": {"type":"string"},
    "organism_id": {"type":"string"},
    "engine_cycle": {"type":"integer","minimum":0},
    "state_revision": {"type":"integer","minimum":0},
    "event_type": {"type":"string"},
    "source_command_id": {"type":"string"},
    "timestamp_utc": {"type":"string"},
    "payload": {"type":"object"},
    "payload_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
